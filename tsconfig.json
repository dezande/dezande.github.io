{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"lib": ["es2024", "dom", "dom.iterable"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"jsx": "react-jsx",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"types": ["node", "jest", "jest-expect-message", "@testing-library/jest-dom", "vite/client"]
	},
	"include": ["tests/**/*.ts", "tests/**/*.tsx", "outils/**/*.ts"]
}
