{
	"name": "mes-tours",
	"private": true,
	"type": "module",
	"homepage": "https://dezande.github.io/mes-tours/",
	"kit": {
		"name": "Mes tours",
		"cachePrefix": "mes-tours",
		"requiredFiles": [
			"fonts/OFL.txt",
			"fonts/OFL-pixelify-sans.txt"
		]
	},
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"dev": "vite",
		"clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
		"build": "vite build && tsc -p src/sw && node src/kit/node/check-dist.ts && node src/kit/node/stamp-build.ts",
		"typecheck": "tsc -p src --noEmit && tsc -p src/sw --noEmit && tsc",
		"test": "jest --selectProjects unitaires composants",
		"check:changelog": "node src/kit/node/check-changelog.ts",
		"test:e2e": "jest --selectProjects e2e --runInBand --forceExit",
		"serve": "npm run build && node src/kit/node/serve.ts",
		"deploy": "node src/kit/node/deploy.ts"
	},
	"devDependencies": {
		"@jest/globals": "^30.5.2",
		"@preact/preset-vite": "^2.10.6",
		"@swc/core": "^1.16.13",
		"@swc/jest": "^0.2.39",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/preact": "^3.2.4",
		"@testing-library/user-event": "^14.6.7",
		"@types/jest": "^30.0.0",
		"@types/jest-expect-message": "^1.0.4",
		"@types/node": "^24.13.4",
		"jest": "^30.5.2",
		"jest-environment-jsdom": "^30.5.2",
		"jest-expect-message": "^1.1.3",
		"sass": "^1.104.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.2"
	},
	"dependencies": {
		"preact": "^11.0.0"
	}
}
