{
	"name": "mes-tours",
	"private": true,
	"type": "module",
	"homepage": "https://dezande.github.io/mes-tours/",
	"kit": {
		"name": "Mes tours",
		"cachePrefix": "mes-tours",
		"requiredFiles": [
			"content/tours.js",
			"menu.js",
			"scene.js",
			"tours/pont.js",
			"tours/boule-de-cristal/index.html",
			"tours/boule-de-cristal/app.js",
			"tours/boule-de-cristal/style.css",
			"tours/analyseur-q/index.html",
			"tours/analyseur-q/app.js",
			"tours/analyseur-q/style.css",
			"tours/six-predictions/index.html",
			"tours/six-predictions/app.js",
			"tours/six-predictions/style.css",
			"tours/pile-ou-face/index.html",
			"tours/pile-ou-face/app.js",
			"tours/pile-ou-face/style.css",
			"pixel.js",
			"content/pixels.js",
			"fonts/pixelify-sans-latin.woff2",
			"fonts/caveat-latin.woff2"
		]
	},
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
		"build": "npm run clean && node -e \"require('node:fs').cpSync('public', 'dist', { recursive: true })\" && sass --no-source-map src/styles/main.scss:dist/style.css src/tours/boule-de-cristal/styles/main.scss:dist/tours/boule-de-cristal/style.css src/tours/analyseur-q/styles/main.scss:dist/tours/analyseur-q/style.css src/tours/six-predictions/styles/main.scss:dist/tours/six-predictions/style.css src/tours/pile-ou-face/styles/main.scss:dist/tours/pile-ou-face/style.css && tsc -p src && tsc -p src/sw && node src/kit/node/check-dist.ts && node src/kit/node/stamp-build.ts",
		"typecheck": "tsc -p src --noEmit && tsc -p src/sw --noEmit && tsc",
		"test": "node --test \"tests/logic/**/*.test.ts\" \"tests/tours/**/*.test.ts\"",
		"check:changelog": "node src/kit/node/check-changelog.ts",
		"test:e2e": "node --test --test-concurrency=1 \"tests/e2e/**/*.e2e.ts\"",
		"serve": "npm run build && node src/kit/node/serve.ts",
		"deploy": "node src/kit/node/deploy.ts"
	},
	"devDependencies": {
		"@types/node": "^24.13.4",
		"sass": "^1.104.1",
		"typescript": "^7.0.2"
	}
}
