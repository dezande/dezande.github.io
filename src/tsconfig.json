{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["es2022", "dom", "dom.iterable"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"jsxImportSource": "preact",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"types": ["vite/client"]
	},
	"include": ["**/*.ts", "**/*.tsx", "../vite.config.ts"],
	"exclude": ["sw", "kit/node", "kit/sw", "kit/tests"]
}
